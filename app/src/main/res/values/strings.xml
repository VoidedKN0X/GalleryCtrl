<resources>
    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Library, sharing, vault and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening GalleryCtrl. The vault can ask for it on its own too.</string>
    <string name="app_lock_footer">GalleryCtrl works fully offline: it has no internet permission, analytics, cloud or AI service. Your photos stay where they are on this phone.</string>
    <string name="lock_prompt_subtitle">Your photos</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. GalleryCtrl will delete everything in the vault (it\'s what the lock protects), reset its settings and turn the app lock off. Your photo library itself isn\'t touched.</string>

